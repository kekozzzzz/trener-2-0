# .clineignore — что Cline НЕ должен читать и отправлять в облако
# Синтаксис как у .gitignore

# ============================================================
# СЕКРЕТЫ
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*credentials*.json

# ============================================================
# ПЕРСОНАЛЬНЫЕ ДАННЫЕ ИГРОКОВ
# HH-файлы содержат реальные никнеймы из маленького сообщества
# ============================================================
/Test/
/uploads/
/storage/
/trener/uploads/
/trener/storage/
/trener/public/help/raw/

# ============================================================
# ПРИВАТНЫЙ БИЗНЕС-КОНТЕКСТ И ИНТЕЛЛЕКТУАЛЬНАЯ СОБСТВЕННОСТЬ
# ============================================================
.business/
coach-materials/

# ============================================================
# МУСОР — не тратить контекст
# ============================================================
node_modules/
.next/
dist/
build/
*.mp4
*.mov
*.webm
graphify-out/
