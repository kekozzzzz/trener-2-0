{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push *--force*)",
      "Bash(git push --force*)",
      "Bash(git push * -f *)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git clean*)",
      "Bash(curl * export *)",
      "Bash(wget * $*)",
      "Bash(cat .env*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)",
      "Bash(dropdb*)",
      "Bash(psql*production*)",
      "Bash(yc * delete*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*TRUNCATE*)",
      "Read(./.env*)",
      "Edit(./.env*)",
      "Write(./.env*)"
    ],
    "allow": [
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx prisma generate*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git fetch*)",
      "Bash(git add*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ ! -f package.json ]; then exit 0; fi; RC=0; echo \"\\n=== tsc ===\"; npx tsc --noEmit 2>&1 | tail -20; RC=$((RC + $?)); echo \"=== lint ===\"; npm run lint --if-present 2>&1 | tail -20; RC=$((RC + $?)); echo \"=== tests ===\"; npm test -- --passWithNoTests --bail 1 2>&1 | tail -20; RC=$((RC + $?)); exit $RC'"
          }
        ]
      }
    ]
  }
}
