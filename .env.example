# ============================================================
# .env.example — шаблон переменных окружения
# Скопируй в .env и заполни реальными значениями
# .env НИКОГДА не коммитится в репозиторий
# ============================================================


# ============================================================
# СЕКРЕТЫ ПРОВАЙДЕРОВ
# ============================================================

# Anthropic API — получить на console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER


# ============================================================
# БАЗА ДАННЫХ
# ============================================================

# PostgreSQL — строка подключения (dev: локальная, prod: Railway/Supabase/Neon)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pokercoach_db


# ============================================================
# ХРАНИЛИЩЕ
# ============================================================

# Тип хранилища загружаемых HH-файлов: "local" или "s3"
STORAGE_TYPE=local

# Локальная папка (только для dev, папка исключена из git)
STORAGE_LOCAL_PATH=./uploads

# S3 — заполнить только если STORAGE_TYPE=s3
# Получить на aws.amazon.com → IAM → Access Keys
AWS_ACCESS_KEY_ID=PLACEHOLDER
AWS_SECRET_ACCESS_KEY=PLACEHOLDER
AWS_S3_BUCKET=pokercoach-hh-files
AWS_S3_REGION=eu-central-1


# ============================================================
# ОПЛАТА
# ============================================================

# Stripe — получить на dashboard.stripe.com → Developers → API Keys
# Используй sk_test_... в dev и sk_live_... в prod
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER

# Webhook secret — получить при создании webhook endpoint в Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# ID ценовых планов — создать в Stripe Dashboard → Products
STRIPE_BASIC_PRICE_ID=price_PLACEHOLDER
STRIPE_ADVANCED_PRICE_ID=price_PLACEHOLDER


# ============================================================
# БИЗНЕС-КОНФИГ
# ============================================================

# Цены в центах (изменять здесь, не в коде — правило #3)
BASIC_TIER_PRICE_CENTS=1200
ADVANCED_TIER_PRICE_CENTS=3000

# Лимит сессий в месяц (0 = безлимит)
BASIC_TIER_SESSION_LIMIT=20
ADVANCED_TIER_SESSION_LIMIT=0

# LLM-модель — менять только осознанно, влияет на качество разборов и стоимость
# Актуальные ID моделей: claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-6

# Максимум токенов на один диалог сессии (контроль стоимости)
LLM_MAX_TOKENS_PER_SESSION=4000
