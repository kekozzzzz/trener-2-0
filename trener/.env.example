# База данных
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trener_dev"

# LLM
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Защита cron-эндпоинтов
CRON_SECRET=""

# Подпись сессионной cookie (HMAC-SHA256) — длинная случайная строка,
# сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Лимиты на точках входа (необязательно — есть рабочие значения по умолчанию).
# Вход: блок после N неудач на email / на IP в окне; регистрация: лимит по IP.
# AUTH_LOGIN_MAX_FAILURES_PER_EMAIL=5
# AUTH_LOGIN_MAX_FAILURES_PER_IP=20
# AUTH_LOGIN_WINDOW_MS=900000
# AUTH_REGISTER_MAX_PER_IP=5
# AUTH_REGISTER_WINDOW_MS=3600000

# Следующие переменные нужны для продакшна, не для локального среза
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""
# YANDEX_S3_BUCKET=""
# YANDEX_S3_ACCESS_KEY=""
# YANDEX_S3_SECRET_KEY=""
# TELEGRAM_BOT_TOKEN=""
# UNISENDER_API_KEY=""
