# Секреты — никогда в репозиторий
.env
.env.local
.env.production
.env.test
*.key
*.pem

# Зависимости
node_modules/

# Next.js
.next/
out/

# HH-файлы пользователей — никогда в репозиторий. Якорим к корню (ведущий «/»),
# чтобы правило НЕ проглатывало код-каталоги с тем же именем (напр. adapters/storage/).
/uploads/
/storage/

# Очередь постов канала (состояние + картинки) — живёт на сервере, не в git
.post-queue/

# Prisma — migrations в git! Они источник правды схемы.
# (Ничего не исключаем из prisma/)

# TypeScript build artifacts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Python build artifacts (trener/scripts/content-qc)
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
